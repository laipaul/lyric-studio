      "layout": "vertical",
      "showNextLine": true,
      "length": { "mode": "target", "seconds": 50, "tolerance": 0.15 },
      "anchor": "hook-first",
      "endOn": "beat",
      "variations": 2,
      "safeZone": { "top": 0.12, "bottom": 0.25, "left": 0, "right": 0.15 },
      "lyricsAt": 0.45,
      "textScale": 1,
      "videoBitrate": "12M",
      "fadeOutSeconds": 0.5,
      "loops": true
    },
    "youtube": {
      "label": "YouTube (16:9, full song)",
