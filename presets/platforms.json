      "anchor": "lead-in",
      "variations": 1,
      "safeZone": { "top": 0.06, "bottom": 0.1, "left": 0.04, "right": 0.04 },
      "lyricsAt": 0.45,
      "textScale": 1,
      "videoBitrate": "16M",
      "fadeOutSeconds": 1.5,
      "youtube": {
