{
  "_help": "Platform presets for pnpm make --platforms. Edit the values; pnpm make checks this file and names any wrong entry. Safe zones are fractions of the frame (0.35 = 35%) covered by the platform's buttons and captions; lyrics stay outside them. lyricsAt: where the lyrics sit inside the usable area (0 = top, 0.5 = middle). length: target = seconds +- tolerance (if no clean line end is in there: up to 25% shorter is preferred, then up to 30% longer), range = min/max/hardMax seconds, full = whole song, loop = min/max seconds. anchor: hook-first = start at most 1 bar before the first hook line; lead-in = one bar before it (earlier if a line is still being sung). endOn: bar = end on a bar start; beat = end on any beat when no bar is clean (bars preferred). showNextLine: the next lyric line waits small underneath (true/false). loops: the platform plays the video in a loop (true for reels, tiktok, shorts): QA \"Loop flows\" and an auto section end that flows back into its start. This file is format only: lyric effects, fonts and colours per platform go in brand.json \"perPlatform\" (or a song's Style tab).",
  "platforms": {
    "standard": {
      "label": "Standard (no --platforms)",
      "width": 1080,
      "height": 1920,
      "aspect": "9:16",
      "layout": "vertical",
      "showNextLine": true,
      "length": { "mode": "range", "min": 45, "max": 60, "hardMax": 65 },
      "anchor": "lead-in",
      "variations": 6,
      "safeZone": { "top": 0.1, "bottom": 0.2, "left": 0, "right": 0.12 },
      "lyricsAt": 0.45,
      "textScale": 1,
      "videoBitrate": null,
      "fadeOutSeconds": 0.5
    },
    "reels": {
      "label": "Instagram Reels",
      "width": 1080,
      "height": 1920,
      "aspect": "9:16",
      "layout": "vertical",
      "showNextLine": true,
      "length": { "mode": "target", "seconds": 30, "tolerance": 0.15 },
      "anchor": "hook-first",
      "variations": 3,
      "safeZone": { "top": 0.14, "bottom": 0.35, "left": 0, "right": 0.12 },
      "lyricsAt": 0.45,
      "textScale": 1,
      "videoBitrate": "10M",
      "fadeOutSeconds": 0.12,
      "loopEnding": true,
      "loops": true
    },
    "tiktok": {
      "label": "TikTok",
      "width": 1080,
