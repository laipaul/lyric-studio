{
  "name": "lyric-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm db:setup && concurrently -k -n studio,worker,audio -c cyan,magenta,yellow \"pnpm --filter @lyric/studio dev\" \"pnpm --filter @lyric/worker dev\" \"node services/audio/scripts/run.mjs\"",
    "audio:setup": "node services/audio/scripts/setup.mjs",
    "analyze": "node services/audio/scripts/analyze.mjs",
    "tap": "node services/audio/scripts/tap.mjs",
    "align": "node services/audio/scripts/align.mjs",
    "lrc:shift": "tsx packages/video/scripts/lrc-shift.ts",
    "lrc:hook": "tsx packages/video/scripts/lrc-hook.ts",
    "cuts": "tsx packages/video/scripts/cuts.ts",
    "render:test": "tsx packages/video/scripts/render-test.ts",
    "make": "tsx packages/video/scripts/make.ts",
    "rerender": "tsx packages/video/scripts/rerender.ts",
    "effects:preview": "tsx packages/video/scripts/effects-preview.ts",
    "songs:migrate": "tsx packages/video/scripts/songs-migrate.ts",
    "brand:set": "tsx packages/video/scripts/brand-set.ts",
    "test:e2e": "tsx apps/studio/e2e/style-lock.e2e.ts && tsx apps/studio/e2e/videos-post.e2e.ts",
    "app:icons": "tsx packages/video/scripts/app-icons.ts",
    "app:serve": "node scripts/app-serve.mjs",
    "fonts": "tsx packages/video/scripts/fonts.ts",
    "db:setup": "pnpm -s --filter @lyric/db run setup",
    "db:migrate": "pnpm -s --filter @lyric/db run migrate",
    "db:seed": "pnpm -s --filter @lyric/db run seed",
    "db:show": "pnpm -s --filter @lyric/db run show",
    "db:generate": "pnpm --filter @lyric/db run generate",
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:audio",
    "test:audio": "node services/audio/scripts/test.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15"
  }
}
