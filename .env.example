# Copy this file to ".env" to change settings. Everything here is optional.

# Where songs, clips, thumbnails, renders and the database are kept.
# Relative paths start from the project folder. Example for another drive:
#   WORKSPACE_DIR=D:\LyricStudio\workspace
WORKSPACE_DIR=./workspace

# Only needed if "ffmpeg -version" does not work in the terminal:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
